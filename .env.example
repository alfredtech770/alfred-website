# Alfred Concierge — environment variables for analytics + search verification.
# Copy to .env.local for local dev, or set in the Vercel project's Environment
# Variables panel for production. Vite only exposes vars prefixed VITE_.

# ── Venue catalog data ──────────────────────────────────────────────
# Public Supabase project values used by read-only catalog queries and the
# partner form. Never expose a service-role key through a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Little Emperors hotel rates (server-side only) ──────────────────
# Configure only with an endpoint and credential explicitly issued or approved
# for Alfred by Little Emperors. The endpoint must return Alfred's normalised
# public-rate contract; private/member-only rates are never published.
# Never prefix either value with VITE_ or expose it in browser code.
LITTLE_EMPERORS_RATES_ENDPOINT=
LITTLE_EMPERORS_API_KEY=

# ── Search Console verification ──────────────────────────────────────
# Substituted into <meta name="google-site-verification"> in index.html.
# Get from https://search.google.com/search-console — pick the HTML tag
# verification method, copy the value of the `content` attribute.
VITE_GSC_VERIFICATION=

# Substituted into <meta name="msvalidate.01"> in index.html. Bing now also
# powers ChatGPT search, so set this even if you mostly care about Google.
# Get from https://www.bing.com/webmasters
VITE_BING_VERIFICATION=

# ── Analytics ────────────────────────────────────────────────────────
# Google Analytics 4 measurement ID, format "G-XXXXXXXXXX".
# Get from https://analytics.google.com — Admin → Property → Data streams.
# Vercel Analytics + Speed Insights run alongside this and need no IDs.
VITE_GA4_ID=

# Google Ads account tag ID (format "AW-123456789") and the conversion
# label for the primary WhatsApp lead action. Both values come from
# Google Ads → Goals → Conversions. A conversion fires only after the
# visitor grants advertising consent and opens an Alfred WhatsApp request.
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_WHATSAPP_LABEL=

# Microsoft Clarity project ID (free heatmaps + session replays).
# Get from https://clarity.microsoft.com — create a project, copy the ID
# from the install snippet (between the quotes after the last comma).
VITE_CLARITY_ID=

# Optional analytics/advertising providers. These scripts remain blocked
# until the visitor grants the corresponding consent in the site banner.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_META_PIXEL_ID=
